# Server-only LLM credential for the Vercel function in api/generate.ts.
# Do not prefix this with VITE_. Vite inlines VITE_ variables into the browser bundle.
LLM_API_KEY=
# Optional OpenAI-compatible Chat Completions base URL. Default: https://api.openai.com/v1
# LLM_API_URL=
# Optional model id. Default: gpt-4o-mini
# LLM_MODEL=
